# 採購後端的位置。你的後端預設跑在 3001 port(http)。
# 若後端開了 SSL,改成 https://localhost:3001
BACKEND_URL=http://localhost:3001

# ── 登入用的帳密 ──
# MCP server 會用這組帳密去 POST /api/auth/login 換取 JWT token,
# 之後呼叫需認證的 API(例如搜尋採購單)時自動帶上。
# 填你後端可登入的帳號(後端有種子帳號 selena.ky.kuo@viewsonic.com)。
BACKEND_EMAIL=selena.ky.kuo@viewsonic.com
BACKEND_PASSWORD='your password on Procurement system'

# ════════════════════════════════════════════════════════════
#  蕃茄鐘 (pomodoro/) 設定
# ════════════════════════════════════════════════════════════

# 蕃茄鐘常駐後端的 port(跟採購後端的 3001 分開)
POMODORO_PORT=3101

# 蕃茄鐘 MCP server 要去打的後端位置。
# 通常不用設,預設會用 http://localhost:<POMODORO_PORT>。
# POMODORO_API_URL=http://localhost:3101

# ⚠️ 實體裝置(ESP32)回報事件時要帶的密鑰,必須設定,否則
#    /api/device/* 會一律回 500。ESP32 韌體裡的 DEVICE_TOKEN 要填一樣的值。
#    請換成一串隨機字串,例如:openssl rand -hex 16
POMODORO_DEVICE_TOKEN=change-me-to-a-random-string

# 你的時區相對 UTC 幾小時(台北 = 8)。
# 紀錄一律存 UTC,這個值只用來決定「今天」從哪一刻算起。
POMODORO_UTC_OFFSET_HOURS=8

# SQLite 檔案位置,預設 pomodoro/data/pomodoro.db
# POMODORO_DB_FILE=./pomodoro/data/pomodoro.db
