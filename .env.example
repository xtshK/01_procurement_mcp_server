# 採購後端的位置。你的後端預設跑在 3001 port(http)。
# 若後端開了 SSL,改成 https://localhost:3001
BACKEND_URL=http://localhost:3001

# ── 登入用的帳密 ──
# MCP server 會用這組帳密去 POST /api/auth/login 換取 JWT token,
# 之後呼叫需認證的 API(例如搜尋採購單)時自動帶上。
# 填你後端可登入的帳號(後端有種子帳號 selena.ky.kuo@viewsonic.com)。
BACKEND_EMAIL=selena.ky.kuo@viewsonic.com
BACKEND_PASSWORD='your password on Procurement system'
